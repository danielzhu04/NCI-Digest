# Public site URL on the lab cluster
PROD_NEXT_PUBLIC_URL=https://nci-signal.k8s.maayanlab.cloud

# Admin login at /admin
ADMIN_PASSWORD=pick-a-local-password

# Community Signals sign-in. Signs the session cookie; use a long random string.
SESSION_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, "Web application").
# Authorized redirect URI: <site origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Fixed origin for OAuth redirects (otherwise taken from the request, e.g. an ngrok host).
# APP_URL=https://nci-signal.k8s.maayanlab.cloud
# Local testing without Google: email-only sign-in. Ignored in production builds.
# ALLOW_DEV_LOGIN=true
# Optional. Extra models users may pick, comma separated. gpt-5.5-2026-04-23 is always offered.
# SIGNAL_MODELS=
# Optional. Generations per user per 24 hours. Default 5.
# SIGNAL_DAILY_LIMIT=5

# Required to generate scripts and TTS audio
OPENAI_API_KEY=

# Optional. Local path for scoped-feed records. Default: data/feeds.json
# NCI_FEEDS_PATH=

# Optional. Which prompt setup in src/tasks/scriptPrompts.py to use.
# v1_paper_discussion = original journal-club shape
# v2_ted_talk = TED-style story arc (current default in scriptPrompts.py)
# NCI_SCRIPT_PROMPT=v2_ted_talk

# Postgres for the generate-podcast job queue (docker compose default shown)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/postgres

# rclone remote name must stay "maayanlab" to match generatePodcast.py
# Ask the lab for the access key, secret, provider, endpoint, and ACL.
RCLONE_CONFIG_MAAYANLAB_TYPE=s3
RCLONE_CONFIG_MAAYANLAB_PROVIDER=
RCLONE_CONFIG_MAAYANLAB_ACCESS_KEY_ID=
RCLONE_CONFIG_MAAYANLAB_SECRET_ACCESS_KEY=
RCLONE_CONFIG_MAAYANLAB_ENDPOINT=https://s3.k8s.maayanlab.cloud
# RCLONE_CONFIG_MAAYANLAB_ACL=public-read Remove this 

# Optional / parked. Paper ranking now uses PubMed Trending, not Altmetric.
# ALTMETRIC_API_KEY=
S3_BUCKET=axiom-podcasts
S3_REMOTE=maayanlab
S3_PREFIX=nci-signal
S3_PUBLIC_BASE=https://s3.k8s.maayanlab.cloud/axiom-podcasts
